# Discord — token do bot (Developer Portal > Bot). Habilite o "Message Content Intent".
DISCORD_TOKEN=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Voz da resposta falada (edge-tts, gratuito). Outras opções: pt-BR-FranciscaNeural, pt-BR-ThalitaNeural
TTS_VOICE=pt-BR-AntonioNeural

# Trello — https://trello.com/power-ups/admin (key) e token de usuário.
# Use `uv run python scripts/list_boards.py` e `uv run python scripts/list_lists.py` para obter os IDs.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_TODO_LIST_ID=
TRELLO_DOING_LIST_ID=
TRELLO_DONE_LIST_ID=
